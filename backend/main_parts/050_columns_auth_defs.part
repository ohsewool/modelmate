
# ── 컬럼 목록 (부분 재실행용) ─────────────────────────────
@app.get("/api/columns")
async def get_columns():
    df = STATE.get("df")
    if df is None: raise HTTPException(400, "데이터 없음")
    return {
        "columns": df.columns.tolist(),
        "current_target": STATE.get("target_col"),
        "current_drop": STATE.get("drop_cols", []),
    }

# ── 인증 ─────────────────────────────────────────────────
class GoogleTokenBody(BaseModel):
    credential: str

@app.post("/api/auth/google")
async def auth_google(body: GoogleTokenBody):
    try:
        info = id_token.verify_oauth2_token(
            body.credential, grequests.Request(), GOOGLE_CLIENT_ID
        )
    except Exception as e:
        raise HTTPException(400, f"Google 토큰 검증 실패: {e}")

    user_id = info["sub"]
    # 구글 계정도 같은 형태로 저장한다. 여기서만 원문을 넣으면 `users.email`에
    # 대소문자만 다른 두 행이 생기고, 이메일로 찾는 모든 코드가 다시 갈라진다.
    email   = normalize_email(info.get("email", ""))
    name    = info.get("name", "")
    picture = info.get("picture", "")

    conn = get_db()
    existing = conn.execute("SELECT id, role FROM users WHERE id=?", (user_id,)).fetchone()
    trusted_role = "admin" if is_admin_email(email) else "user"
    if not existing:
        role = trusted_role
        conn.execute(
            "INSERT INTO users (id, email, name, picture, role, plan, created_at) VALUES (?,?,?,?,?,?,?)",
            (user_id, email, name, picture, role, "admin" if role == "admin" else "free", datetime.now().isoformat())
        )
        conn.commit()
        if role == "admin" and "record_security_event" in globals():
            record_security_event(
                "auth.admin_account_created",
                f"구글 로그인으로 관리자 계정이 만들어졌다: {email}",
                user_id=user_id, route="/api/auth/google", method="POST", status_code=200,
                safe_details={"email": email, "source": "구글 로그인 · ADMIN_EMAILS 목록 일치"},
            )
    else:
        role = "admin" if trusted_role == "admin" or existing["role"] == "admin" else "user"
        if role == "admin" and existing["role"] != "admin":
            conn.execute("UPDATE users SET role='admin', plan='admin' WHERE id=?", (user_id,))
            conn.commit()
            if "record_security_event" in globals():
                record_security_event(
                    "auth.admin_granted",
                    f"구글 로그인 중 기존 계정이 관리자가 됐다: {email}",
                    user_id=user_id, route="/api/auth/google", method="POST", status_code=200,
                    safe_details={"email": email, "previous_role": existing["role"],
                                  "source": "ADMIN_EMAILS 목록 일치"},
                )
    conn.close()

    token = make_token(user_id, email, name, picture, role=role)
    return {"token": token, "user": {"id": user_id, "email": email, "name": name, "picture": picture, "role": role}}

class EmailAuthBody(BaseModel):
    email: str
    password: str
    name: str = ""

def make_token(user_id, email, name, picture="", role="user"):
    session_id = secrets.token_hex(16)
    now = datetime.now()
    expires_at = datetime.fromtimestamp(now.timestamp() + 60 * 60 * 24 * 7)
    payload = {
        "sub": user_id,
        "email": email,
        "name": name or "",
        "picture": picture or "",
        "role": role or "user",
        "jti": session_id,
        "exp": int(expires_at.timestamp()),
    }
    token = jose_jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALGORITHM)
    conn = get_db()
    conn.execute(
        """INSERT OR REPLACE INTO auth_sessions
           (id, user_id, session_token_hash, created_at, expires_at, revoked_at)
           VALUES (?,?,?,?,?,NULL)""",
        (session_id, user_id, hashlib.sha256(session_id.encode()).hexdigest(), now.isoformat(), expires_at.isoformat()),
    )
    conn.commit()
    conn.close()
    return token
