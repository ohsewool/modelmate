PLAN_LIMITS = {
    "free": {
        "max_projects": 3,
        "max_datasets": 3,
        "max_file_size_mb": 10,
        "max_rows_per_dataset": 5000,
        "max_columns_per_dataset": 100,
        "max_jobs_per_day": 5,
        "max_concurrent_jobs": 1,
        "max_prediction_tokens_per_project": 1,
        "max_prediction_api_calls_per_day": 100,
        "max_report_exports_per_day": 10,
    },
    "pro_mock": {
        "max_projects": 30,
        "max_datasets": 30,
        "max_file_size_mb": 50,
        "max_rows_per_dataset": 50000,
        "max_columns_per_dataset": 300,
        "max_jobs_per_day": 50,
        "max_concurrent_jobs": 3,
        "max_prediction_tokens_per_project": 5,
        "max_prediction_api_calls_per_day": 5000,
        "max_report_exports_per_day": 100,
    },
    "team_mock": {
        "max_projects": 100,
        "max_datasets": 100,
        "max_file_size_mb": 100,
        "max_rows_per_dataset": 100000,
        "max_columns_per_dataset": 500,
        "max_jobs_per_day": 150,
        "max_concurrent_jobs": 8,
        "max_prediction_tokens_per_project": 20,
        "max_prediction_api_calls_per_day": 25000,
        "max_report_exports_per_day": 500,
    },
    "admin": {
        "max_projects": None,
        "max_datasets": None,
        "max_file_size_mb": None,
        "max_rows_per_dataset": None,
        "max_columns_per_dataset": None,
        "max_jobs_per_day": None,
        "max_concurrent_jobs": None,
        "max_prediction_tokens_per_project": None,
        "max_prediction_api_calls_per_day": None,
        "max_report_exports_per_day": None,
    },
}


def ensure_usage_limit_storage():
    conn = get_db()
    user_cols = [r[1] for r in conn.execute("PRAGMA table_info(users)").fetchall()]
    for name, ddl in {
        "plan": "TEXT DEFAULT 'free'",
        "plan_status": "TEXT DEFAULT 'active'",
        "plan_source": "TEXT DEFAULT 'default'",
        "trial_ends_at": "TEXT",
        "updated_at": "TEXT",
    }.items():
        if name not in user_cols:
            conn.execute(f"ALTER TABLE users ADD COLUMN {name} {ddl}")
    conn.execute("UPDATE users SET plan='admin', plan_status='internal', plan_source='seed' WHERE role='admin'")
    conn.execute("UPDATE users SET plan=COALESCE(plan, 'free'), plan_status=COALESCE(plan_status, 'active'), plan_source=COALESCE(plan_source, 'default')")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS user_usage_daily (
            user_id TEXT NOT NULL,
            usage_date TEXT NOT NULL,
            jobs_count INTEGER DEFAULT 0,
            prediction_calls_count INTEGER DEFAULT 0,
            report_exports_count INTEGER DEFAULT 0,
            updated_at TEXT,
            PRIMARY KEY (user_id, usage_date)
        )
    """)
    conn.commit()
    conn.close()


def _usage_today():
    return datetime.now().date().isoformat()


def _usage_now():
    return datetime.now().isoformat(timespec="seconds")


def get_user_email(user):
    return (user or {}).get("email", "").strip().lower()


def getUserRole(user):
    if not user:
        return "guest_demo"
    if user.get("is_guest") or str(user.get("sub", "")).startswith("guest:"):
        return "guest_demo"
    if user.get("role") == "admin" or is_admin_email(get_user_email(user)):
        return "admin"
    return "free"


def get_user_role(user):
    return getUserRole(user)


def isAdminUser(user):
    return getUserRole(user) == "admin"


def is_admin_user_id(user_id):
    if not user_id:
        return False
    conn = get_db()
    try:
        row = conn.execute("SELECT email, role FROM users WHERE id=?", (user_id,)).fetchone()
    finally:
        conn.close()
    return bool(row and (row["role"] == "admin" or is_admin_email(row["email"])))


def normalize_plan(plan, role=None):
    if role == "admin":
        return "admin"
    return plan if plan in PLAN_LIMITS else "free"


def _user_id_from_payload(user):
    return user.get("sub") if user else None


def get_user_plan(user):
    if not user:
        return "free"
    if isAdminUser(user):
        return "admin"
    conn = get_db()
    try:
        row = conn.execute("SELECT plan, role FROM users WHERE id=?", (_user_id_from_payload(user),)).fetchone()
    finally:
        conn.close()
    return normalize_plan(row["plan"] if row else user.get("plan"), row["role"] if row else user.get("role"))


def get_plan_limits(user_or_plan):
    plan = user_or_plan if isinstance(user_or_plan, str) else get_user_plan(user_or_plan)
    limits = dict(PLAN_LIMITS.get(plan, PLAN_LIMITS["free"]))
    if plan == "admin":
        return limits
    env_map = {
        "max_file_size_mb": "MODELMATE_MAX_FILE_SIZE_MB",
        "max_rows_per_dataset": "MODELMATE_MAX_ROWS_PER_DATASET",
        "max_columns_per_dataset": "MODELMATE_MAX_COLUMNS_PER_DATASET",
    }
    if plan == "free":
        env_map.update({
        "max_projects": "FREE_MAX_PROJECTS",
        "max_datasets": "FREE_MAX_DATASETS",
        "max_jobs_per_day": "FREE_MAX_ANALYSIS_RUNS",
        "max_prediction_tokens_per_project": "FREE_MAX_PREDICTION_APIS",
        "max_report_exports_per_day": "FREE_MAX_REPORTS",
        })
    for key, env_name in env_map.items():
        if os.getenv(env_name):
            try:
                limits[key] = int(os.getenv(env_name))
            except ValueError:
                # 조용히 넘기면 운영자는 **자기가 설정한 값이 걸려 있다고 믿는다.**
                # 실제로는 기본값이 걸린다 — 사용량 제한은 남용을 막는 장치라
                # 더 헐거워진 쪽으로 틀리는 것이 보통이다. 응답은 그대로(기본값으로
                # 계속 간다) 두되 **말은 한다.**
                if "record_security_event" in globals():
                    record_security_event(
                        "config.usage_limit_ignored",
                        f"{env_name}의 값이 정수가 아니라 기본값을 쓴다",
                        severity="warning",
                        safe_details={"env_name": env_name, "limit_key": key},
                    )
    return limits


def checkQuota(user, action):
    if isAdminUser(user):
        return {"allowed": True, "role": "admin", "plan": "admin", "limit": None, "current": None}
    action_to_limit = {
        "project": ("max_projects", "projects"),
        "dataset": ("max_datasets", "datasets"),
        "job": ("max_jobs_per_day", "jobs_today"),
        "training": ("max_jobs_per_day", "jobs_today"),
        "quick_analysis": ("max_jobs_per_day", "jobs_today"),
        "goal_analysis": ("max_jobs_per_day", "jobs_today"),
        "prediction_api": ("max_prediction_api_calls_per_day", "prediction_api_calls_today"),
        "report_export": ("max_report_exports_per_day", "report_exports_today"),
    }
    limit_key, usage_key = action_to_limit.get(action, (None, None))
    if not limit_key:
        return {"allowed": True, "role": getUserRole(user), "plan": get_user_plan(user), "limit": None, "current": None}
    limits = get_plan_limits(user or "free")
    usage = get_account_usage(user) if user else {}
    limit = limits.get(limit_key)
    current = usage.get(usage_key, 0)
    return {
        "allowed": limit is None or current < limit,
        "role": getUserRole(user),
        "plan": get_user_plan(user) if user else "free",
        "limit_key": limit_key,
        "usage_key": usage_key,
        "limit": limit,
        "current": current,
    }


def ensure_usage_day(conn, user_id):
    today = _usage_today()
    conn.execute(
        "INSERT OR IGNORE INTO user_usage_daily (user_id, usage_date, updated_at) VALUES (?, ?, ?)",
        (user_id, today, _usage_now()),
    )
    return today


def get_daily_usage(user_id):
    if not user_id:
        return {"jobs_today": 0, "prediction_api_calls_today": 0, "report_exports_today": 0}
    conn = get_db()
    try:
        today = ensure_usage_day(conn, user_id)
        conn.commit()
        row = conn.execute("SELECT * FROM user_usage_daily WHERE user_id=? AND usage_date=?", (user_id, today)).fetchone()
    finally:
        conn.close()
    return {
        "jobs_today": row["jobs_count"] if row else 0,
        "prediction_api_calls_today": row["prediction_calls_count"] if row else 0,
        "report_exports_today": row["report_exports_count"] if row else 0,
    }


def increment_daily_usage(user_id, key, amount=1):
    if not user_id:
        return
    if is_admin_user_id(user_id):
        return
    column = {
        "jobs_today": "jobs_count",
        "prediction_api_calls_today": "prediction_calls_count",
        "report_exports_today": "report_exports_count",
    }.get(key)
    if not column:
        return
    conn = get_db()
    try:
        today = ensure_usage_day(conn, user_id)
        conn.execute(
            f"UPDATE user_usage_daily SET {column}=COALESCE({column}, 0)+?, updated_at=? WHERE user_id=? AND usage_date=?",
            (amount, _usage_now(), user_id, today),
        )
        conn.commit()
    finally:
        conn.close()


DAILY_USAGE_COLUMNS = {
    "jobs_today": "jobs_count",
    "prediction_api_calls_today": "prediction_calls_count",
    "report_exports_today": "report_exports_count",
}


def claim_daily_usage(user_id, key, limit):
    """한도 안이면 1 올리고 True, 이미 찼으면 아무것도 안 하고 False.

    읽고-판단하고-쓰는 것을 **한 문장**으로 한다. 나눠 하면 그 사이에 다른 요청이
    같은 값을 읽는다 — `enforce_*` 뒤에 `increment_daily_usage`를 부르는 이 저장소의
    기존 방식이 그렇다. 2026-08-22에 쟀다: 한도 10에 동시 20건을 넣으니 **12건이
    통과**했다. 보고서 내보내기는 검사와 기록 사이에 보고서 생성이 통째로 들어가
    창이 가장 넓다.

    SQLite는 한 `UPDATE`를 원자적으로 처리하므로 `WHERE`에 한도를 넣으면 스레드
    사이에서도 프로세스 사이에서도 초과가 생기지 않는다. `rowcount`가 0이면 그
    문장이 아무 행도 바꾸지 못했다는 뜻이고, 그것이 곧 "한도가 찼다"이다.

    `limit`이 `None`이면 무제한이다. 0과 헷갈리면 유료 사용자가 막힌다.
    """
    if not user_id or is_admin_user_id(user_id):
        return True
    column = DAILY_USAGE_COLUMNS.get(key)
    if not column:
        return True
    conn = get_db()
    try:
        today = ensure_usage_day(conn, user_id)
        if limit is None:
            conn.execute(
                f"UPDATE user_usage_daily SET {column}=COALESCE({column}, 0)+1, updated_at=? WHERE user_id=? AND usage_date=?",
                (_usage_now(), user_id, today),
            )
            conn.commit()
            return True
        cursor = conn.execute(
            f"UPDATE user_usage_daily SET {column}=COALESCE({column}, 0)+1, updated_at=? "
            f"WHERE user_id=? AND usage_date=? AND COALESCE({column}, 0) < ?",
            (_usage_now(), user_id, today, limit),
        )
        conn.commit()
        return cursor.rowcount > 0
    finally:
        conn.close()


def get_account_usage(user):
    user_id = _user_id_from_payload(user)
    if not user_id:
        return {
            "projects": 0,
            "datasets": 0,
            "jobs_today": 0,
            "active_jobs": 0,
            "prediction_api_calls_today": 0,
            "report_exports_today": 0,
            "prediction_tokens": 0,
        }
    conn = get_db()
    try:
        projects = conn.execute(
            "SELECT COUNT(*) FROM projects WHERE user_id=? AND COALESCE(archive_status,'active')='active' AND deleted_at IS NULL",
            (user_id,),
        ).fetchone()[0]
        datasets = conn.execute(
            "SELECT COUNT(*) FROM datasets WHERE user_id=? AND deleted_at IS NULL",
            (user_id,),
        ).fetchone()[0]
        active_jobs = conn.execute(
            "SELECT COUNT(*) FROM training_jobs WHERE user_id=? AND status IN ('created','queued','running')",
            (user_id,),
        ).fetchone()[0]
        prediction_tokens = conn.execute(
            "SELECT COUNT(*) FROM prediction_api_tokens WHERE owner_user_id=? AND status='active'",
            (user_id,),
        ).fetchone()[0]
        today = ensure_usage_day(conn, user_id)
        conn.commit()
        daily = conn.execute("SELECT * FROM user_usage_daily WHERE user_id=? AND usage_date=?", (user_id, today)).fetchone()
    finally:
        conn.close()
    return {
        "projects": projects,
        "datasets": datasets,
        "jobs_today": daily["jobs_count"] if daily else 0,
        "active_jobs": active_jobs,
        "prediction_api_calls_today": daily["prediction_calls_count"] if daily else 0,
        "report_exports_today": daily["report_exports_count"] if daily else 0,
        "prediction_tokens": prediction_tokens,
    }


def usage_limit_error(limit_key, current, limit, plan, message=None):
    user_message = message or "현재 플랜의 사용 한도에 도달했습니다."
    return HTTPException(429, {
        "code": "usage_limit_exceeded",
        "limit_key": limit_key,
        "current": current,
        "limit": limit,
        "plan": plan,
        "message": user_message,
        "user_friendly_message": user_message,
        "recommended_next_action": "기존 분석 결과를 확인하거나 추가 사용이 필요하면 관리자에게 문의해 주세요.",
        "upgrade_placeholder": "베타 기간에는 플랜 변경을 수동으로 처리합니다. 필요하면 관리자에게 문의하세요.",
    })


def enforce_limit(user, limit_key, current, message=None):
    plan = get_user_plan(user)
    if plan == "admin":
        return
    if limit_key == "max_jobs_per_day":
        message = "오늘 실행 가능한 분석 횟수를 모두 사용했습니다."
    elif limit_key == "max_concurrent_jobs":
        message = "동시에 실행 가능한 분석 작업 수를 모두 사용했습니다."
    limit = get_plan_limits(plan).get(limit_key)
    if limit is not None and current >= limit:
        raise usage_limit_error(limit_key, current, limit, plan, message)


def enforce_project_creation_limit(user):
    if not user:
        return
    if isAdminUser(user):
        return
    usage = get_account_usage(user)
    enforce_limit(user, "max_projects", usage["projects"], "현재 플랜에서 만들 수 있는 프로젝트 수를 모두 사용했습니다.")


def enforce_dataset_upload_limits(user, file_size_bytes, rows, columns):
    limits = get_plan_limits(user or "free")
    plan = get_user_plan(user) if user else "free"
    if plan == "admin":
        return
    file_mb = file_size_bytes / (1024 * 1024)
    checks = [
        ("max_file_size_mb", file_mb, limits["max_file_size_mb"], "업로드 가능한 CSV 파일 크기 제한을 넘었습니다."),
        ("max_rows_per_dataset", rows, limits["max_rows_per_dataset"], "현재 플랜에서 처리할 수 있는 행 수를 넘었습니다."),
        ("max_columns_per_dataset", columns, limits["max_columns_per_dataset"], "현재 플랜에서 처리할 수 있는 컬럼 수를 넘었습니다."),
    ]
    for key, current, limit, message in checks:
        if limit is not None and current > limit:
            raise usage_limit_error(key, int(current), limit, plan, message)
    if user:
        usage = get_account_usage(user)
        enforce_limit(user, "max_datasets", usage["datasets"], "현재 플랜에서 저장 가능한 데이터셋 수를 모두 사용했습니다.")


def enforce_training_job_limits(user):
    """작업을 시작하기 전의 빠른 거절.

    권위는 아니다 — 여기서 통과해도 실제로 세는 것은 `claim_analysis_job`이고,
    그 사이에 다른 요청이 마지막 자리를 가져갈 수 있다. 이 함수가 있는 이유는
    **비싼 일을 시작하기 전에** 거절하기 위해서다. 없애면 한도에 걸린 사용자가
    모델 비교를 끝까지 돌린 뒤에 429를 받는다.
    """
    if isAdminUser(user):
        return
    usage = get_account_usage(user)
    enforce_limit(user, "max_jobs_per_day", usage["jobs_today"], "오늘 실행 가능한 분석 작업 수를 모두 사용했습니다.")
    enforce_limit(user, "max_concurrent_jobs", usage["active_jobs"], "동시에 실행 가능한 분석 작업 수를 모두 사용했습니다.")


def claim_analysis_job(user_or_id):
    """분석 작업 하나를 센다. 한도가 찼으면 429로 거절한다.

    예전에는 `increment_daily_usage(user_id, "jobs_today")`였다 — **세기만 하고
    판단하지 않았다.** 판단은 엔드포인트 입구의 `enforce_training_job_limits`가
    따로 했고, 그 사이에 분석이 통째로 들어간다. 2026-08-22에 보고서 내보내기에서
    같은 모양을 쟀다: 한도 10에 동시 20건 중 12건 통과.

    그리고 더 큰 것이 옆에 있었다. **`/api/run-cv`는 어떤 `enforce_*`도 부르지
    않았다.** 세기는 하는데(이 경로를 통해) 막지는 않았다 — 무료 플랜 한도 5에
    8회를 연속으로 200으로 통과시키는 것을 확인했다. 모델을 실제로 학습·비교하는,
    한도가 존재하는 이유인 바로 그 엔드포인트다.

    이제 세는 자리가 곧 판단하는 자리다. 입구 검사는 빠른 거절로 남는다.
    """
    user_id = user_or_id if isinstance(user_or_id, str) else _user_id_from_payload(user_or_id)
    if not user_id or is_admin_user_id(user_id):
        return
    user = user_or_id if not isinstance(user_or_id, str) else {"sub": user_id}
    limit = get_plan_limits(user).get("max_jobs_per_day")
    if not claim_daily_usage(user_id, "jobs_today", limit):
        usage = get_daily_usage(user_id)
        raise usage_limit_error("max_jobs_per_day", usage["jobs_today"], limit,
                                get_user_plan(user),
                                "오늘 실행 가능한 분석 작업 수를 모두 사용했습니다.")


def claim_prediction_api_call(owner_user_id):
    """예측 API 호출 하나를 센다. 한도가 찼으면 429.

    `enforce_prediction_call_limit`은 입구에 남는다 — 호출을 넘기기 전에 거절하는
    편이 낫다. 권위는 여기다.
    """
    if not owner_user_id or is_admin_user_id(owner_user_id):
        return
    user = {"sub": owner_user_id}
    conn = get_db()
    try:
        row = conn.execute("SELECT plan, role FROM users WHERE id=?", (owner_user_id,)).fetchone()
    finally:
        conn.close()
    if row:
        user["plan"] = row["plan"]
        user["role"] = row["role"]
    limit = get_plan_limits(user).get("max_prediction_api_calls_per_day")
    if not claim_daily_usage(owner_user_id, "prediction_api_calls_today", limit):
        usage = get_daily_usage(owner_user_id)
        raise usage_limit_error("max_prediction_api_calls_per_day",
                                usage["prediction_api_calls_today"], limit,
                                get_user_plan(user),
                                "오늘 예측 API 호출 한도에 도달했습니다.")


def enforce_prediction_token_limit(user, project_id):
    plan = get_user_plan(user)
    if plan == "admin":
        return
    limit = get_plan_limits(plan)["max_prediction_tokens_per_project"]
    conn = get_db()
    try:
        count = conn.execute(
            "SELECT COUNT(*) FROM prediction_api_tokens WHERE project_id=? AND owner_user_id=? AND status='active'",
            (project_id, _user_id_from_payload(user)),
        ).fetchone()[0]
    finally:
        conn.close()
    if count >= limit:
        raise usage_limit_error("max_prediction_tokens_per_project", count, limit, plan, "이 프로젝트에서 만들 수 있는 API 토큰 수를 모두 사용했습니다.")


def enforce_report_export_limit(user):
    """보고서 내보내기 한도. **선언만 되고 강제되지 않았다.**

    `PLAN_LIMITS`의 모든 요금제가 `max_report_exports_per_day`를 갖고 있고
    (free 10, pro 100, team 500), 사용량 테이블에 `report_exports_count` 열이
    있고, `checkQuota`가 `report_export` 액션을 그 한도에 매핑한다. `docs/pricing.md`도
    보고서 내보내기를 요금제 항목으로 싣는다.

    **그런데 세는 곳도 막는 곳도 없었다.** `increment_daily_usage`는
    `jobs_today`와 `prediction_api_calls_today`로만 불렸고, `enforce_limit`은
    이 키로 한 번도 불리지 않았다. 한도 표·DB 열·요금제 문서까지 다 있는데
    강제만 빠진, 이 프로젝트가 반복해서 만나는 "정의만 되고 배선 안 된 통제"다.

    `checkQuota` 자체도 아무도 부르지 않는다 - 같은 질문에 답하는 구현이 둘인데
    하나만 배선돼 있고, 배선된 쪽이 이 액션을 모르고 있었다.

    다른 `enforce_*`와 같은 규칙을 따른다: 신원이 없으면(게스트·미인증) 통과시킨다.
    그쪽은 계정 사용량이라는 개념 자체가 없고, 여기서 막으면 데모 경로가 깨진다.
    """
    if not user:
        return
    if isAdminUser(user):
        return
    usage = get_account_usage(user)
    enforce_limit(user, "max_report_exports_per_day", usage["report_exports_today"],
                  "오늘 사용할 수 있는 보고서 내보내기 횟수를 모두 사용했습니다.")


def record_report_export(user):
    """내보내기 하나를 센다. 세지 않으면 한도는 영원히 0에 머문다.

    **여기서 다시 판단한다.** `enforce_report_export_limit`은 응답을 시작하기 전에
    빨리 거절하려고 있고, 그 사이에 보고서 생성이 통째로 들어간다 — 동시에 들어온
    요청들이 전부 같은 값을 읽고 전부 통과한다. 쟀더니 한도 10에 동시 20건 중
    **12건이 통과했다**(2026-08-22).

    `claim_daily_usage`는 세는 것과 판단하는 것을 한 문장으로 한다. 진 쪽은 보고서를
    만들어놓고 429를 받는다 — 일은 버려지지만 한도는 넘지 않는다. 반대로 하면
    (미리 세어두고 실패하면 되돌리기) 400으로 끝난 호출이 할당량을 먹는 경로가
    생기고, 그건 실패를 벌로 만드는 쪽이다.
    """
    if not user:
        return
    user_id = _user_id_from_payload(user)
    if not user_id:
        return
    limit = get_plan_limits(user).get("max_report_exports_per_day")
    if not claim_daily_usage(user_id, "report_exports_today", limit):
        usage = get_account_usage(user)
        raise usage_limit_error("max_report_exports_per_day",
                                usage["report_exports_today"], limit,
                                get_user_plan(user),
                                "오늘 사용할 수 있는 보고서 내보내기 횟수를 모두 사용했습니다.")


def enforce_prediction_call_limit(owner_user_id):
    if is_admin_user_id(owner_user_id):
        return
    user = {"sub": owner_user_id}
    conn = get_db()
    try:
        row = conn.execute("SELECT plan, role FROM users WHERE id=?", (owner_user_id,)).fetchone()
    finally:
        conn.close()
    if row:
        user["plan"] = row["plan"]
        user["role"] = row["role"]
    usage = get_daily_usage(owner_user_id)
    enforce_limit(user, "max_prediction_api_calls_per_day", usage["prediction_api_calls_today"], "오늘 예측 API 호출 한도에 도달했습니다.")


def build_usage_summary(user):
    if not user:
        return {
            "mode": "guest_demo",
            "role": "guest_demo",
            "plan": "free",
            "plan_label": "게스트 데모",
            "limit_label": "데모 제한 적용",
            "is_admin": False,
            "limits": get_plan_limits("free"),
            "usage": {},
            "warnings": [],
            "upgrade": {"available": False, "message": "로그인하면 프로젝트별 사용량을 확인할 수 있습니다."},
        }
    role = getUserRole(user)
    plan = get_user_plan(user)
    plan_labels = {
        "free": "무료",
        "trial": "체험",
        "pro": "Pro",
        "pro_mock": "Pro",
        "team_mock": "Team",
    }
    limits = get_plan_limits(plan)
    usage = get_account_usage(user)
    if role == "admin":
        return {
            "mode": "authenticated",
            "role": "admin",
            "plan": "admin",
            "plan_label": "관리자",
            "limit_label": "제한 없음",
            "is_admin": True,
            "limits": limits,
            "usage": usage,
            "percent_used": {},
            "warnings": [],
            "capabilities": {
                "can_create_project": True,
                "can_upload_dataset": True,
                "can_start_job": True,
                "can_call_prediction_api": True,
                "quota_bypass": True,
            },
            "upgrade": {
                "available": False,
                "message": "관리자 계정은 데모와 검증을 위해 사용량 제한이 적용되지 않습니다.",
            },
        }
    mapping = {
        "projects": "max_projects",
        "datasets": "max_datasets",
        "jobs_today": "max_jobs_per_day",
        "active_jobs": "max_concurrent_jobs",
        "prediction_api_calls_today": "max_prediction_api_calls_per_day",
        "report_exports_today": "max_report_exports_per_day",
    }
    percent_used = {}
    warnings = []
    for usage_key, limit_key in mapping.items():
        limit = limits.get(limit_key) or 0
        current = usage.get(usage_key, 0)
        percent = round(current / limit, 2) if limit else 0
        percent_used[usage_key] = percent
        if percent >= 0.8:
            warnings.append({
                "limit_key": limit_key,
                "message": "사용량이 현재 플랜의 한도에 가까워졌습니다.",
                "current": current,
                "limit": limit,
            })
    return {
        "mode": "authenticated",
        "role": role,
        "plan": plan,
        "plan_label": plan_labels.get(plan, "기본"),
        "limit_label": f"{plan_labels.get(plan, '기본')} 플랜 한도 적용",
        "is_admin": False,
        "plan_status": "internal" if plan == "admin" else "active",
        "limits": limits,
        "usage": usage,
        "percent_used": percent_used,
        "warnings": warnings,
        "capabilities": {
            "can_create_project": usage["projects"] < limits["max_projects"],
            "can_upload_dataset": usage["datasets"] < limits["max_datasets"],
            "can_start_job": usage["jobs_today"] < limits["max_jobs_per_day"] and usage["active_jobs"] < limits["max_concurrent_jobs"],
            "can_call_prediction_api": usage["prediction_api_calls_today"] < limits["max_prediction_api_calls_per_day"],
        },
        "upgrade": {
            "available": False,
            "message": "베타 기간에는 플랜 변경을 수동으로 처리합니다. Pro/Team mock 플랜은 관리자에게 문의하세요.",
        },
    }


ensure_usage_limit_storage()


# ── 인증 이전 경로의 한도 ──────────────────────────────────
#
# 이 파일의 다른 모든 한도는 **계정에** 걸린다. 로그인·가입·구글 로그인은 계정이
# 정해지기 전이라 아무 한도도 없었다.
#
# 그 자체로도 문제지만, 2026-08-22에 **내가 그 표면을 넓혔다.** 로그인 응답 시간이
# 계정 존재를 알려주는 것을 고치면서(280ms 대 10ms), 없는 계정에도 pbkdf2 26만 회를
# 돌게 했다. 전에는 실재하는 계정을 알아야 비쌌고 이제는 아무 문자열이나 같은 값을
# 치른다. 재봤다: **인증 없는 로그인 시도 60건(동시 12)에 `/api/state`가 3.1ms에서
# 1,844.9ms로, 603배**가 됐다. 앱이 사실상 멈춘다.
#
# 시간차를 되돌리지는 않는다 — 그건 진짜 누출이었다. 필요한 것은 애초에 있었어야 할
# 조임이다.
AUTH_ATTEMPT_LIMIT = int(os.getenv("MODELMATE_AUTH_ATTEMPTS_PER_MINUTE", "10"))
AUTH_ATTEMPT_WINDOW = 60.0
_AUTH_ATTEMPTS = {}
_AUTH_ATTEMPTS_LOCK = threading.Lock()


def _auth_client_key(request):
    """어느 호출자로 셀 것인가.

    `request.client.host`를 쓴다. `X-Forwarded-For`는 **믿지 않는다** — 호출자가
    직접 채우는 헤더라 그것으로 세면 헤더만 바꿔가며 무한히 통과한다. 프록시 뒤에
    두면 여러 사용자가 한 칸을 나눠 쓰게 되는데, 그 방향의 실패는 조이는 쪽이다.
    """
    client = getattr(request, "client", None)
    return getattr(client, "host", None) or "unknown"


def enforce_auth_attempt_limit(request):
    """인증 이전 시도를 조인다. 한도를 넘으면 429.

    **한 프로세스 안에서만이다.** 워커가 여럿이면 각자 자기 통을 갖는다 —
    `mcp-gateway`의 감사 로그에서와 같은 한계이고, 같은 이유로 적어둔다. 여러
    프로세스에 걸친 조임은 공유 저장소가 필요하고 그건 별도 작업이다.
    """
    if AUTH_ATTEMPT_LIMIT <= 0:
        return
    key = _auth_client_key(request)
    now = time.time()
    with _AUTH_ATTEMPTS_LOCK:
        # 오래된 칸을 버린다. 버리지 않으면 IP 하나당 항목 하나가 영원히 쌓인다.
        for stale in [k for k, v in _AUTH_ATTEMPTS.items()
                      if not v or now - v[-1] > AUTH_ATTEMPT_WINDOW]:
            if stale != key:
                _AUTH_ATTEMPTS.pop(stale, None)
        attempts = [stamp for stamp in _AUTH_ATTEMPTS.get(key, [])
                    if now - stamp <= AUTH_ATTEMPT_WINDOW]
        if len(attempts) >= AUTH_ATTEMPT_LIMIT:
            _AUTH_ATTEMPTS[key] = attempts
            retry_after = int(AUTH_ATTEMPT_WINDOW - (now - attempts[0])) + 1
            raise HTTPException(429, {
                "code": "auth_attempts_exceeded",
                "message": "로그인 시도가 너무 잦습니다. 잠시 후 다시 시도해 주세요.",
                "retry_after_seconds": retry_after,
            })
        attempts.append(now)
        _AUTH_ATTEMPTS[key] = attempts


@app.get("/api/me/usage")
async def me_usage(user=Depends(get_current_user)):
    return build_usage_summary(user)
