def is_hosted_deployment() -> bool:
    """플랫폼 위에서 도는가. 로컬 데모와 배포를 같은 규칙으로 다루면 둘 중 하나가 틀린다."""
    if os.getenv("RAILWAY_ENVIRONMENT_NAME", "").strip():
        return True
    return os.getenv("ENVIRONMENT", "").strip().lower() in {"production", "prod", "staging"}


def resolve_jwt_secret() -> str:
    """토큰 서명 키.

    예전에는 `os.getenv("JWT_SECRET", "modelmate-secret-key-change-in-prod")`였다.
    그 상수는 **공개 저장소에 그대로 적혀 있다.** 설정하지 않은 배포에서는 누구나
    `{"role": "admin"}`을 서명해 관리자로 통과할 수 있다 — 계정이 없어도 된다.
    2026-08-22에 실제로 해봤다: 위조 토큰으로 `/api/auth/me`가 200과 `role: admin`,
    `/api/me/usage`가 `limit_label: 제한 없음`을 돌려줬다.

    `.env.example`은 `JWT_SECRET=`(빈 값)으로 안내한다. `os.getenv`는 빈 문자열도
    "설정됨"으로 보므로 그대로 따르면 **빈 키로 서명**한다 — 기본 상수보다 나쁘다.
    바로 두 줄 아래 `DB_PATH`는 `.strip() or` 로 같은 함정을 이미 피하고 있었다.

    배포에서는 부팅을 거부한다. 로컬에서는 설치마다 다른 키를 파일에 만든다 —
    매번 새로 만들면 재시작이나 워커 추가에 토큰이 깨지고, 그건 사람들이 끄고 싶어
    하는 종류의 안전장치다.
    """
    configured = os.getenv("JWT_SECRET", "").strip()
    if configured:
        return configured
    if is_hosted_deployment():
        raise RuntimeError(
            "JWT_SECRET이 설정되지 않았다. 배포에서는 기본값으로 부팅하지 않는다 — "
            "저장소에 적힌 값으로 서명하면 누구나 관리자 토큰을 만들 수 있다. "
            "긴 난수를 JWT_SECRET에 넣어라 (`python3 -c \"import secrets;"
            "print(secrets.token_urlsafe(48))\"`)."
        )
    base = REPO_ROOT if DB_PATH == ":memory:" else os.path.dirname(os.path.abspath(DB_PATH))
    path = os.path.join(base, ".jwt_secret")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            existing = handle.read().strip()
        if existing:
            return existing
    except OSError:
        # 파일이 없거나 못 읽는다 — 아래에서 새로 만든다. **일부러 삼킨다.**
        pass
    generated = secrets.token_urlsafe(48)
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(generated + "\n")
    except OSError:
        # 읽기 전용 파일시스템 등. 프로세스 안에서만 유효한 키로 계속 간다 —
        # 공개된 상수를 쓰는 것보다는 낫고, 배포 경로는 위에서 이미 막혔다.
        pass
    return generated


JWT_SECRET = resolve_jwt_secret()

def get_allowed_origins():
    configured = os.getenv("ALLOWED_ORIGINS", "")
    if configured.strip():
        return [origin.strip().rstrip("/") for origin in configured.split(",") if origin.strip()]
    return ["http://localhost:3000", "http://127.0.0.1:3000"]

def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_db()
    conn.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id TEXT PRIMARY KEY,
            email TEXT UNIQUE NOT NULL,
            name TEXT,
            picture TEXT,
            password_hash TEXT,
            role TEXT DEFAULT 'user',
            created_at TEXT
        )
    """)
    # 기존 테이블에 password_hash 컬럼 없으면 추가
    cols = [r[1] for r in conn.execute("PRAGMA table_info(users)").fetchall()]
    if "password_hash" not in cols:
        conn.execute("ALTER TABLE users ADD COLUMN password_hash TEXT")
    if "role" not in cols:
        conn.execute("ALTER TABLE users ADD COLUMN role TEXT DEFAULT 'user'")
    if "plan" not in cols:
        conn.execute("ALTER TABLE users ADD COLUMN plan TEXT DEFAULT 'free'")
    if "updated_at" not in cols:
        conn.execute("ALTER TABLE users ADD COLUMN updated_at TEXT")

    # 대소문자만 다른 두 계정을 DB가 직접 막는다. `email TEXT UNIQUE`는 SQLite의
    # 기본 비교를 쓰므로 `admin@...`과 `ADMIN@...`을 서로 다른 값으로 본다 —
    # 그 틈으로 관리자 계정이 하나 더 만들어졌다(2026-08-22).
    #
    # 앱 층에서도 막지만(`find_user_by_email`), **검사 하나에만 기대면 다음에
    # 추가되는 경로가 그것을 부르지 않는다.** 이 저장소가 반복해서 만난 모양이라
    # 여기서는 두 층 모두에 둔다.
    #
    # 이미 대소문자만 다른 행이 있는 DB에서는 인덱스 생성이 실패한다. 그때 부팅을
    # 막으면 기존 배포가 죽으므로, 실패를 삼키지 않고 **남긴다** — 조용히 넘어가면
    # 다음 사람은 인덱스가 있다고 믿는다.
    try:
        conn.execute("CREATE UNIQUE INDEX IF NOT EXISTS users_email_ci ON users(lower(email))")
    except Exception as exc:
        print(f"[auth] users(lower(email)) 유니크 인덱스를 만들지 못했다: {exc}. "
              f"대소문자만 다른 계정이 이미 있는지 확인하라 — "
              f"SELECT lower(email), COUNT(*) FROM users GROUP BY 1 HAVING COUNT(*) > 1")

    # 관리자 계정 자동 생성 (없을 때만).
    #
    # 비밀번호 기본값이 `admin1234`였다. 어느 문서에도 적혀 있지 않았고
    # `.env.example`은 `ADMIN_PASSWORD=`(빈 값)으로 안내한다 — 그대로 따르면
    # **빈 문자열이 비밀번호인 관리자 계정**이 만들어졌다. 그리고
    # `get_admin_emails()`는 설정과 무관하게 `admin@modelmate.local`을 항상
    # 관리자로 넣으므로(문서화된 동작), 그 계정은 어느 배포에나 존재했다.
    #
    # 이제 `ADMIN_PASSWORD`가 없으면 **비밀번호 없이** 만든다. `/api/auth/login`은
    # `password_hash`가 비면 이미 거부한다 — 계정은 존재하되 비밀번호 로그인이
    # 열리지 않는다. 여는 것은 운영자의 명시적 선택이어야 한다.
    #
    # 여기 있던 두 번째 자동 생성 블록은 지웠다. `ADMIN_EMAIL`(단수)을 따로 읽어
    # 계정을 만들었는데, `ADMIN_EMAILS`(복수)가 설정되면 `get_admin_emails()`는
    # 단수를 무시한다 — 문서화된 목록에 없는 이메일이 관리자가 되는 **두 번째
    # 경로**였고 어느 문서에도 없었다. 이제 권위는 `get_admin_emails()` 하나다.
    admin_pw = os.getenv("ADMIN_PASSWORD", "").strip()
    admin_hash = hash_password(admin_pw) if admin_pw else None
    import uuid
    for configured_admin_email in sorted(get_admin_emails()):
        # `find_user_by_email`로 찾는다. 예전처럼 `WHERE email=?`로 찾으면 대소문자
        # 섞인 옛 행(`Admin@Modelmate.Local`)을 못 찾고 INSERT로 넘어가는데, 위에서
        # 만든 `users(lower(email))` 유니크 인덱스가 그것을 거절해 **부팅이 죽는다.**
        # 인덱스를 넣으면서 이 줄을 같이 고치지 않으면 새 통제가 기존 배포를 깨뜨린다.
        existing_admin = find_user_by_email(conn, configured_admin_email, "id, password_hash, role")
        if not existing_admin:
            new_admin_id = str(uuid.uuid4())
            conn.execute(
                "INSERT INTO users (id, email, name, picture, password_hash, role, created_at) VALUES (?,?,?,?,?,?,?)",
                (new_admin_id, configured_admin_email, "관리자", "", admin_hash, "admin", datetime.now().isoformat())
            )
            note_security_event(
                "auth.admin_account_created",
                f"관리자 계정이 생성됐다: {configured_admin_email}",
                user_id=new_admin_id,
                safe_details={"email": configured_admin_email, "source": "ADMIN_EMAILS 시딩",
                              "password_login": bool(admin_hash)},
            )
        else:
            # 갱신은 `id`로 한다. 이메일로 다시 찾으면 방금 한 조회와 다른 기준을
            # 쓰게 되고, 그 어긋남이 이 회차가 고친 결함 그 자체다.
            if admin_hash and not existing_admin["password_hash"]:
                conn.execute("UPDATE users SET password_hash=? WHERE id=?",
                             (admin_hash, existing_admin["id"]))
                note_security_event(
                    "auth.admin_password_set",
                    f"관리자 계정에 비밀번호 로그인이 열렸다: {configured_admin_email}",
                    user_id=existing_admin["id"],
                    safe_details={"email": configured_admin_email},
                )
            # **바뀔 때만** 남긴다. 매 부팅마다 남기면 그 줄은 배경 소음이 되고,
            # 배경 소음은 아무도 읽지 않는다.
            if existing_admin["role"] != "admin":
                note_security_event(
                    "auth.admin_granted",
                    f"기존 계정이 관리자가 됐다: {configured_admin_email}",
                    user_id=existing_admin["id"],
                    safe_details={"email": configured_admin_email,
                                  "previous_role": existing_admin["role"],
                                  "source": "ADMIN_EMAILS 시딩"},
                )
            conn.execute(
                "UPDATE users SET role='admin', plan='admin', name=COALESCE(NULLIF(name, ''), '관리자') WHERE id=?",
                (existing_admin["id"],),
            )

    conn.execute("""
        CREATE TABLE IF NOT EXISTS deployed_models (
            id TEXT PRIMARY KEY,
            name TEXT NOT NULL,
            task_type TEXT NOT NULL,
            best_model_name TEXT,
            target_col TEXT,
            features TEXT,
            metrics TEXT,
            created_at TEXT
        )
    """)
    deploy_cols = [r[1] for r in conn.execute("PRAGMA table_info(deployed_models)").fetchall()]
    if "user_id" not in deploy_cols:
        conn.execute("ALTER TABLE deployed_models ADD COLUMN user_id TEXT")
    if "dataset_ref" not in deploy_cols:
        conn.execute("ALTER TABLE deployed_models ADD COLUMN dataset_ref TEXT")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS projects (
            id TEXT PRIMARY KEY,
            user_id TEXT NOT NULL,
            name TEXT NOT NULL,
            description TEXT,
            created_at TEXT,
            updated_at TEXT,
            FOREIGN KEY (user_id) REFERENCES users(id)
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS datasets (
            id TEXT PRIMARY KEY,
            project_id TEXT NOT NULL,
            user_id TEXT NOT NULL,
            filename TEXT NOT NULL,
            rows INTEGER,
            columns INTEGER,
            target_col TEXT,
            domain TEXT,
            quality TEXT,
            created_at TEXT,
            FOREIGN KEY (project_id) REFERENCES projects(id),
            FOREIGN KEY (user_id) REFERENCES users(id)
        )
    """)
