PENDING_SECURITY_EVENTS = []


def note_security_event(event_type, message, **fields):
    """권한이 바뀐 사실을 대기열에 넣는다.

    `init_db()`는 조립 순서상 `098_monitoring.part`보다 먼저 돈다 — 그때는
    `persist_monitoring_event`가 아직 없다. 그래서 부팅 중에 일어난 권한 변경은
    여기 모아두고, 기록 장치가 준비되면 비운다.

    왜 필요한가: 이 앱은 **400 이상만** `monitoring_events`에 남긴다. 실패는 전부
    남고 **누군가 관리자가 되는 순간은 하나도 남지 않았다.** 탐지가 정확히
    거꾸로였다. 2026-08-22에 확인했다 — `ADMIN_EMAILS`에 이메일 하나를 추가하고
    앱을 다시 띄우면 그 계정이 관리자로 바뀌는데, 감사 이벤트는 **0건**이었다.
    """
    PENDING_SECURITY_EVENTS.append({"event_type": event_type, "message": message, **fields})


def normalize_email(value):
    """계정을 찾을 때 쓰는 단 하나의 이메일 형태.

    이것이 없어서 **한 질문에 두 개의 동일성 기준**이 있었다. 가입의 중복 검사는
    `WHERE email=?`로 SQLite 기본 비교(대소문자 구분)를 썼고, 관리자 판정은
    `is_admin_email`이 소문자로 낮춰 비교했다. 엄격한 쪽이 계정 생성을 막고
    느슨한 쪽이 권한을 줬다 — 최악의 짝이다.

    2026-08-22에 확인: `ADMIN@modelmate.local`로 **자기 비밀번호를 정해 가입**하면
    중복에 걸리지 않고(시딩된 행은 `admin@...`) `role: admin`, `plan: admin`,
    `is_admin: true`, 한도 `제한 없음`을 받았다. 바로 앞 회차에 시딩된 관리자
    계정을 **비밀번호 없이** 만들도록 고쳤는데, 이 경로는 그것을 통째로 지나간다.

    이메일의 도메인부는 대소문자를 구분하지 않고, 로컬부는 규격상 구분할 수 있지만
    실제 제공자는 구분하지 않는다. 여기서 중요한 것은 어느 쪽이 옳은가가 아니라
    **모든 곳이 같은 답을 쓰는가**다.
    """
    return str(value or "").strip().lower()


def get_admin_emails():
    configured = os.getenv("ADMIN_EMAILS") or os.getenv("ADMIN_EMAIL") or "admin@modelmate.local"
    emails = {normalize_email(email) for email in configured.split(",") if email.strip()}
    emails.add("admin@modelmate.local")
    return emails

def is_admin_email(email):
    return bool(email and normalize_email(email) in get_admin_emails())


def find_user_by_email(conn, email, columns="*"):
    """이메일로 계정 하나를 찾는다. **모든 조회가 이 함수를 지나야 한다.**

    `lower(email)`로 비교하므로 정규화 이전에 만들어진 대소문자 섞인 행도 찾는다.
    """
    return conn.execute(
        f"SELECT {columns} FROM users WHERE lower(email)=?", (normalize_email(email),)
    ).fetchone()

def hash_password(password: str) -> str:
    salt = secrets.token_hex(16)
    hashed = hashlib.pbkdf2_hmac("sha256", password.encode(), salt.encode(), 260000)
    return f"{salt}${hashed.hex()}"

# 계정이 없을 때도 같은 계산을 하기 위한 가짜 해시.
#
# `hash_password`로 만들지 않는다 — 그러면 부팅 때 pbkdf2 26만 회를 돌려 시작이
# 0.25초 느려진다. 형식만 맞으면 `verify_password`가 같은 pbkdf2를 돌고 실패한다.
DUMMY_PASSWORD_HASH = "0" * 32 + "$" + "0" * 64


def verify_password(password: str, stored: str) -> bool:
    try:
        salt, hashed = stored.split("$")
        check = hashlib.pbkdf2_hmac("sha256", password.encode(), salt.encode(), 260000)
        return check.hex() == hashed
    except Exception:
        return False

