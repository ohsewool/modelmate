@app.post("/api/auth/signup")
async def auth_signup(body: EmailAuthBody, request: Request = None):
    """가입. 이메일은 **정규화한 형태 하나로** 저장하고 찾는다.

    예전에는 중복 검사가 `WHERE email=?`(대소문자 구분)였고 역할 판정은
    `is_admin_email`(소문자 비교)이었다. `ADMIN@modelmate.local`로 가입하면
    중복에 걸리지 않으면서 관리자 역할을 받았다 — 자기가 정한 비밀번호로.
    경위는 `normalize_email`의 설명에 있다.
    """
    if request is not None and "enforce_auth_attempt_limit" in globals():
        enforce_auth_attempt_limit(request)
    import uuid
    email = normalize_email(body.email)
    if not email or "@" not in email:
        raise HTTPException(400, "이메일 형식이 올바르지 않습니다")
    conn = get_db()
    existing = find_user_by_email(conn, email, "id")
    if existing:
        conn.close()
        raise HTTPException(400, "이미 사용 중인 이메일입니다")
    user_id = str(uuid.uuid4())
    password_hash = hash_password(body.password)
    name = body.name or email.split("@")[0]
    role = "admin" if is_admin_email(email) else "user"
    conn.execute(
        "INSERT INTO users (id, email, name, picture, password_hash, role, created_at) VALUES (?,?,?,?,?,?,?)",
        (user_id, email, name, "", password_hash, role, datetime.now().isoformat())
    )
    conn.commit(); conn.close()
    if role == "admin" and "record_security_event" in globals():
        record_security_event(
            "auth.admin_account_created",
            f"가입으로 관리자 계정이 만들어졌다: {email}",
            user_id=user_id, route="/api/auth/signup", method="POST", status_code=200,
            safe_details={"email": email, "source": "가입 시 ADMIN_EMAILS 목록 일치"},
        )
    token = make_token(user_id, email, name, role=role)
    return {"token": token, "user": {"id": user_id, "email": email, "name": name, "picture": "", "role": role}}

@app.post("/api/auth/register")
async def auth_register(body: EmailAuthBody):
    return await auth_signup(body)

@app.post("/api/auth/login")
async def auth_login(body: EmailAuthBody, request: Request = None):
    # 인증 이전 경로의 유일한 한도다. 이 아래 `verify_password`는 계정이 있든
    # 없든 pbkdf2 26만 회를 돈다 - 조이지 않으면 인증 없이 서버를 세울 수 있다.
    if request is not None and "enforce_auth_attempt_limit" in globals():
        enforce_auth_attempt_limit(request)
    conn = get_db()
    # 가입과 같은 동일성으로 찾는다. 대소문자만 다른 이메일이 다른 계정이 되면
    # 그것이 이 회차에 고친 결함이고, 여기서 다시 갈라지면 원래대로 돌아간다.
    row = find_user_by_email(conn, body.email)
    conn.close()
    # 두 갈래가 **같은 일을 해야 한다.** 메시지는 원래도 같았지만 시간이 달랐다:
    # 계정이 없으면 즉시 400, 있으면 pbkdf2 26만 회를 돌고 400. 2026-08-22에 쟀다 —
    # 중앙값 10ms 대 280ms, **27배**. 메시지를 같게 해두고 응답 시간이 답을 알려주는
    # 상태였고, 270ms는 네트워크 잡음에 묻히지 않는다.
    #
    # 계정이 없을 때도 가짜 해시로 같은 계산을 돌린다. 버리는 계산이지만, 버리지
    # 않으면 계정 목록이 새어 나간다.
    if not row or not row["password_hash"]:
        verify_password(body.password, DUMMY_PASSWORD_HASH)
        raise HTTPException(400, "이메일 또는 비밀번호가 올바르지 않습니다")
    if not verify_password(body.password, row["password_hash"]):
        raise HTTPException(400, "이메일 또는 비밀번호가 올바르지 않습니다")
    role = getUserRole({"email": row["email"], "role": row["role"] or "user"})
    if role == "admin" and row["role"] != "admin":
        conn = get_db()
        conn.execute("UPDATE users SET role='admin', plan='admin' WHERE id=?", (row["id"],))
        conn.commit()
        conn.close()
        # 로그인 한 번으로 역할이 바뀐다. 200으로 끝나므로 미들웨어는 이것을
        # 남기지 않는다 - 성공한 권한 상승이야말로 남아야 하는 것이다.
        if "record_security_event" in globals():
            record_security_event(
                "auth.admin_granted",
                f"로그인 중 기존 계정이 관리자가 됐다: {row['email']}",
                user_id=row["id"], route="/api/auth/login", method="POST", status_code=200,
                safe_details={"email": row["email"], "previous_role": row["role"] or "user",
                              "source": "ADMIN_EMAILS 목록 일치"},
            )
    token = make_token(row["id"], row["email"], row["name"], row["picture"] or "", role=role)
    return {"token": token, "user": {"id": row["id"], "email": row["email"], "name": row["name"], "picture": row["picture"] or "", "role": role}}

@app.get("/api/auth/me")
async def auth_me(user=Depends(get_current_user)):
    if not user:
        raise HTTPException(401, "로그인이 필요합니다")
    return user

# ── 기록 ─────────────────────────────────────────────────
@app.get("/api/history")
async def get_history(user=Depends(get_current_user)):
    if user:
        conn = get_db()
        if user.get("role") == "admin":
            rows = conn.execute(
                "SELECT e.data, e.created_at, u.email, u.name FROM experiments e LEFT JOIN users u ON e.user_id=u.id ORDER BY e.id DESC LIMIT 200"
            ).fetchall()
        else:
            rows = conn.execute(
                "SELECT data, created_at FROM experiments WHERE user_id=? ORDER BY id DESC LIMIT 50",
                (user["sub"],)
            ).fetchall()
        conn.close()
        items = []
        for r in rows:
            item = json.loads(r["data"])
            if user.get("role") == "admin":
                item["owner_email"] = r["email"] or ""
                item["owner_name"] = r["name"] or ""
            items.append(item)
        return items
    return load_history()

@app.delete("/api/history")
async def clear_history(user=Depends(get_current_user)):
    if user:
        conn = get_db()
        if user.get("role") == "admin":
            conn.execute("DELETE FROM experiments")
        else:
            conn.execute("DELETE FROM experiments WHERE user_id=?", (user["sub"],))
        conn.commit()
        conn.close()
        return {"ok": True}
    if os.path.exists(HISTORY_FILE): os.remove(HISTORY_FILE)
    return {"ok": True}

@app.get("/api/profile/summary")
async def profile_summary(user=Depends(get_current_user)):
    if not user:
        return {
            "logged_in": False,
            "user": None,
            "workspace": {"name": "임시 작업공간", "scope": "브라우저 임시 기록"},
            "project_count": 0,
            "dataset_count": 0,
            "history_count": len(load_history()),
            "best_score": None,
            "last_experiment_at": None,
            "task_counts": {},
            "message": "로그인하면 실험 기록이 계정별로 저장됩니다.",
        }

    conn = get_db()
    db_user = conn.execute(
        "SELECT id, email, name, picture, role, created_at FROM users WHERE id=?",
        (user["sub"],)
    ).fetchone()
    if user.get("role") == "admin":
        rows = conn.execute(
            "SELECT data, created_at FROM experiments ORDER BY id DESC LIMIT 500"
        ).fetchall()
    else:
        rows = conn.execute(
            "SELECT data, created_at FROM experiments WHERE user_id=? ORDER BY id DESC LIMIT 200",
            (user["sub"],)
        ).fetchall()
    user_count = conn.execute("SELECT COUNT(*) AS n FROM users").fetchone()["n"]
    project_count = conn.execute(
        "SELECT COUNT(*) AS n FROM projects WHERE user_id=?", (user["sub"],)
    ).fetchone()["n"]
    dataset_count = conn.execute(
        "SELECT COUNT(*) AS n FROM datasets WHERE user_id=?", (user["sub"],)
    ).fetchone()["n"]
    conn.close()

    history = [json.loads(r["data"]) for r in rows]
    best_score = None
    task_counts = {}
    for item in history:
        task = item.get("task_type") or "unknown"
        task_counts[task] = task_counts.get(task, 0) + 1
        results = item.get("results") or []
        first = results[0] if results else {}
        score = item.get("tuned_score")
        if score is None:
            score = first.get("roc_auc", first.get("r2"))
        try:
            score = float(score)
            best_score = score if best_score is None else max(best_score, score)
        except (TypeError, ValueError):
            pass

    profile = dict(db_user) if db_user else {
        "id": user["sub"],
        "email": user.get("email", ""),
        "name": user.get("name", ""),
        "picture": user.get("picture", ""),
        "role": user.get("role", "user"),
        "created_at": None,
    }
    if user.get("role") != "admin":
        ensure_default_project(user["sub"])
        project_count = max(project_count, 1)
    return {
        "logged_in": True,
        "user": profile,
        "is_admin": user.get("role") == "admin",
        "workspace": {
            "name": "관리자 작업공간" if user.get("role") == "admin" else "기본 작업공간",
            "scope": "전체 사용자 관리" if user.get("role") == "admin" else "내 분석 자산",
        },
        "user_count": int(user_count),
        "project_count": int(project_count),
        "dataset_count": int(dataset_count),
        "history_count": len(history),
        "best_score": round(best_score, 4) if best_score is not None else None,
        "last_experiment_at": rows[0]["created_at"] if rows else None,
        "task_counts": task_counts,
        "message": "관리자는 전체 기록을 볼 수 있습니다." if user.get("role") == "admin" else "로그인한 계정의 실험 기록만 보여줍니다.",
    }

@app.get("/api/admin/users")
async def admin_users(user=Depends(get_current_user)):
    if not user or user.get("role") != "admin":
        raise HTTPException(403, "관리자 권한이 필요합니다")
    conn = get_db()
    rows = conn.execute(
        """
        SELECT u.id, u.email, u.name, u.picture, u.role, u.created_at,
               COUNT(e.id) AS experiment_count
        FROM users u
        LEFT JOIN experiments e ON e.user_id = u.id
        GROUP BY u.id
        ORDER BY u.created_at DESC
        """
    ).fetchall()
    conn.close()
    return [dict(r) for r in rows]

