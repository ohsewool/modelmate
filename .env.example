# Optional OpenAI summary foundation. The app works with LLM_ENABLED=false.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_INPUT_CHARS=12000

# Auth-lite admin role and configurable free-plan guardrails.
#
# JWT_SECRET: leave it EMPTY only for local runs. The app then generates a
# per-install key in `.jwt_secret` next to the database. A hosted deployment
# (RAILWAY_ENVIRONMENT_NAME set, or ENVIRONMENT=production/staging) refuses to
# boot without it. There used to be a hardcoded fallback that is published in
# this repository - anyone could sign `{"role": "admin"}` with it and pass.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ADMIN_PASSWORD: leave it EMPTY unless you want password login for the
# bootstrap admin. Empty means the account exists with no password set, and
# `/api/auth/login` refuses it. The old default was `admin1234`, undocumented.
ADMIN_EMAILS=admin@modelmate.local
ADMIN_PASSWORD=
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Runtime networking and persistence. Same-origin Railway deploys can leave
# VITE_API_URL empty. Set ALLOWED_ORIGINS for a separately hosted frontend.
ALLOWED_ORIGINS=http://localhost:3000
VITE_API_URL=
DB_PATH=
MODELS_DIR=
DATASETS_DIR=

FREE_MAX_PROJECTS=3
FREE_MAX_DATASETS=3
FREE_MAX_ANALYSIS_RUNS=5
FREE_MAX_PREDICTION_APIS=1
FREE_MAX_REPORTS=10
MODELMATE_MAX_FILE_SIZE_MB=10
MODELMATE_MAX_ROWS_PER_DATASET=5000
MODELMATE_MAX_COLUMNS_PER_DATASET=100

# Attempts per minute per client address for the pre-authentication routes
# (/api/auth/login, /api/auth/signup, /api/auth/google). Every other limit in
# this app is per account, and those three run before an account is known.
# A failed login runs pbkdf2 260,000 times whether or not the address exists,
# so without this an unauthenticated caller can spend the server's CPU freely:
# 60 attempts took /api/state from 3.1 ms to 1,844.9 ms. Set to 0 to disable,
# knowing that is what you are doing.
MODELMATE_AUTH_ATTEMPTS_PER_MINUTE=10
